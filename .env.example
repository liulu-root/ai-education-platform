# Optional: only needed when EDU_AI_PROVIDER=openai-compatible
EDU_AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_CONTEXT_WINDOW_TOKENS=16384
AI_MAX_OUTPUT_TOKENS=2048
EMBEDDING_PROVIDER=local-hash
EMBEDDING_MODEL=text-embedding-3-small

# Optional: Milvus is NOT required for the default profile
VECTOR_STORE=in-memory
MILVUS_BASE_URL=http://localhost:19530
MILVUS_TOKEN=root:Milvus
